msgid "열기"
msgstr "開ける"

#. Key:	LeftoverInnerLockedThought
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1252)
#: Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1252)
msgctxt "IGMissingFloor,LeftoverInnerLockedThought"
msgid "안에서 잠겼어."
msgstr "内側から鍵がかかってる。"

#. Key:	LeftoverPieceAThought
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1381)
#: Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1381)
