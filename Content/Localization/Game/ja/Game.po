msgid "조작"
msgstr "操作"

#. Key:	A11yCategoryGeneral
#. SourceLocation:	Source/IndieGame/Player/IGHorrorHUD.cpp(5595)
#: Source/IndieGame/Player/IGHorrorHUD.cpp(5595)
msgctxt "IGHUD,A11yCategoryGeneral"
msgid "기타"
msgstr "その他"

#. Key:	AccessibilityTitle
#. SourceLocation:	Source/IndieGame/Player/IGHorrorHUD.cpp(5606)
#: Source/IndieGame/Player/IGHorrorHUD.cpp(5606)
msgctxt "IGHUD,AccessibilityTitle"
msgid "접근성 설정"
msgstr "アクセシビリティ設定"

#. Key:	AccessibilitySubtitle
#. SourceLocation:	Source/IndieGame/Player/IGHorrorHUD.cpp(5607)
#: Source/IndieGame/Player/IGHorrorHUD.cpp(5607)
msgctxt "IGHUD,AccessibilitySubtitle"
msgid "글자, 소리 안내, 조작을 편하게 맞춰 주세요."
msgstr "文字サイズや音の案内、操作方法などを調整できます。"

#. Key:	AccessibilitySavedImmediately
#. SourceLocation:	Source/IndieGame/Player/IGHorrorHUD.cpp(5608)
#: Source/IndieGame/Player/IGHorrorHUD.cpp(5608)
msgctxt "IGHUD,AccessibilitySavedImmediately"
msgid "변경 즉시 저장"
msgstr "変更は即時保存"

#. Key:	SettingsEffectHeading
#. SourceLocation:	Source/IndieGame/Player/IGHorrorHUD.cpp(5658)
#: Source/IndieGame/Player/IGHorrorHUD.cpp(5658)
msgctxt "IGHUD,SettingsEffectHeading"
