msgid "401호 문 살짝 열리는 소리"
msgstr "401号室のドアが少し開く音"

#. Key:	HwangSpeaker
#. SourceLocation:	Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(6181)
#: Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(6181)
