msgid "화면 효과"
msgstr "画面効果"

#. Key:	A11yCategorySound
#. SourceLocation:	Source/IndieGame/Player/IGHorrorHUD.cpp(5592)
#: Source/IndieGame/Player/IGHorrorHUD.cpp(5592)
msgctxt "IGHUD,A11yCategorySound"
msgid "소리 알림"
msgstr "音の補助"

#. Key:	A11yCategoryCaptions
#. SourceLocation:	Source/IndieGame/Player/IGHorrorHUD.cpp(5593)
#: Source/IndieGame/Player/IGHorrorHUD.cpp(5593)
msgctxt "IGHUD,A11yCategoryCaptions"
msgid "자막"
msgstr "字幕"

#. Key:	A11yCategoryInput
#. SourceLocation:	Source/IndieGame/Player/IGHorrorHUD.cpp(5594)
#: Source/IndieGame/Player/IGHorrorHUD.cpp(5594)
