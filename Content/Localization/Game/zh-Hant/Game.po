msgid "401호, 402호 앞 살펴보기"
msgstr "看看401室、402室門口"

#. Key:	ArrivalObjectiveRoof
#. SourceLocation:	Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(2741)
#: Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(2741)
msgctxt "IGMissingFloor,ArrivalObjectiveRoof"
