msgid "판 밑에 쐐기 끼우기"
msgstr "把木楔塞到板子底下"

#. Key:	LeftoverWardrobePrompt
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorLeftoverStorage.cpp(239)
#: Source/IndieGame/Entity/IGMissingFloorLeftoverStorage.cpp(239)
