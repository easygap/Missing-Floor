msgid "장갑 주머니 챙기기"
msgstr "拿走手套袋"

#. Key:	LeftoverLedgerPrompt
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1046)
#: Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1046)
msgctxt "IGMissingFloor,LeftoverLedgerPrompt"
msgid "보관함 열어 보기"
msgstr "打開置物櫃看看"

#. Key:	LeftoverLedgerTitle
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1048)
#: Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1048)
