#: Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1050)
msgctxt "IGMissingFloor,LeftoverLedger1"
msgid "202  정우     겨울 장비 1상자          24.11.3"
msgstr "202  正宇     冬季裝備 1箱             24.11.3"

#. Key:	LeftoverLedger2
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1051)
#: Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1051)
