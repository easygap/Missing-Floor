#: Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(2724)
msgctxt "IGMissingFloor,ArrivalObjectiveContract"
msgid "책상 위 임대차계약서 보기"
msgstr "看桌上的租賃契約"

#. Key:	ArrivalObjectiveBoxes
#. SourceLocation:	Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(2728)
#: Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(2728)
msgctxt "IGMissingFloor,ArrivalObjectiveBoxes"
msgid "오빠가 남긴 짐 살펴보기"
msgstr "查看哥哥留下的東西"

#. Key:	ArrivalObjectiveStore
#. SourceLocation:	Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(2732)
#: Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(2732)
msgctxt "IGMissingFloor,ArrivalObjectiveStore"
msgid "편의점 직원에게 오빠 소식 묻기"
msgstr "向便利商店店員打聽哥哥的消息"

#. Key:	ArrivalObjectiveNeighbors
#. SourceLocation:	Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(2737)
#: Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(2737)
