msgid "막에 붙은 조각 떼어 내기"
msgstr "撕下黏在膜上的碎片"

#. Key:	LeftoverGloveBoxPrompt
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1023)
#: Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1023)
msgctxt "IGMissingFloor,LeftoverGloveBoxPrompt"
msgid "상자 열어 보기"
msgstr "打開箱子看看"

#. Key:	LeftoverGlovesPrompt
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1028)
#: Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1028)
