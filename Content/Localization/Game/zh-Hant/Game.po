msgid "[7월 27일 · 가까이] 얕은 숨소리  ·  [오른쪽] 물 흐르는 소리"
msgstr "［7月27日 · 近處］淺淺的呼吸聲  ·  ［右側］流水聲"

#. Key:	FifthDawnCaptionWaterShift
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(372)
#: Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(372)
msgctxt "IGMissingFloor,FifthDawnCaptionWaterShift"
msgid "[머리 위] 배관 크게 덜컹거리는 소리"
msgstr "［上方］水管劇烈震動的聲音"

#. Key:	FifthDawnCaptionSecondDawn
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(390)
#: Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(390)
msgctxt "IGMissingFloor,FifthDawnCaptionSecondDawn"
msgid "[7월 28일] 발소리와 불경 소리가 점점 멀어진다"
msgstr "［7月28日］腳步聲和誦經聲漸漸遠去"

#. Key:	FifthDawnCaptionThirdDawn
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(458)
#: Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(458)
msgctxt "IGMissingFloor,FifthDawnCaptionThirdDawn"
msgid "[7월 29일] 벽을 긁는 소리"
msgstr "［7月29日］刮牆壁的聲音"

#. Key:	FifthDawnCaptionDohaCall
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(510)
#: Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(510)
msgctxt "IGMissingFloor,FifthDawnCaptionDohaCall"
msgid "[벽 안] 둘, 쉬고, 하나"
msgstr "［牆內］兩下，停一下，再一下"

#. Key:	FifthDawnCaptionHwangReply
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(529)
#: Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(529)
msgctxt "IGMissingFloor,FifthDawnCaptionHwangReply"
msgid "[아주 멀리] 같은 박자로 대답하는 소리"
msgstr "［極遠處］用同樣節奏回應的聲音"

#. Key:	FifthDawnCaptionFourthDawn
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(549)
#: Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(549)
msgctxt "IGMissingFloor,FifthDawnCaptionFourthDawn"
msgid "[7월 30일] 느리고 약한 숨소리"
msgstr "［7月30日］緩慢微弱的呼吸聲"

#. Key:	FifthDawnCaptionFinalDawn
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(562)
#: Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(562)
msgctxt "IGMissingFloor,FifthDawnCaptionFinalDawn"
msgid "[7월 31일] 다섯 번째 새벽"
msgstr "［7月31日］第五個凌晨"

#. Key:	FifthDawnCaptionNoReply
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(579)
#: Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(579)
msgctxt "IGMissingFloor,FifthDawnCaptionNoReply"
msgid "[벽 안] 두 번 두드리는 소리  ·  대답 없음"
msgstr "［牆內］兩下敲擊聲  ·  沒有回應"

#. Key:	FifthDawnCaptionBreathOnly
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(596)
#: Source/IndieGame/Entity/IGMissingFloorFifthDawnDirector.cpp(596)
msgctxt "IGMissingFloor,FifthDawnCaptionBreathOnly"
msgid "[가까이] 희미한 숨소리"
msgstr "［近處］微弱的呼吸聲"

#. Key:	FinalRevealBegin
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1345)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1345)
msgctxt "IGMissingFloor,FinalRevealBegin"
msgid "위에서부터 천천히 비춰 본다."
msgstr "從上面慢慢照下來。"

#. Key:	FinalRevealSkull
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1422)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1422)
msgctxt "IGMissingFloor,FinalRevealSkull"
msgid "고개가 옷깃 쪽으로 푹 숙여져 있다."
msgstr "頭深深垂向衣領。"

#. Key:	FinalRevealRibs
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1450)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1450)
msgctxt "IGMissingFloor,FinalRevealRibs"
msgid "갈비뼈 사이에 석고 가루가 쌓여 있다. 오래됐어."
msgstr "肋骨之間積了石膏粉。已經很久了。"

#. Key:	FinalRevealShoes
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1496)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1496)
msgctxt "IGMissingFloor,FinalRevealShoes"
msgid "한쪽 발이 안으로 꺾여 있다. 방수포, 카트 바퀴… 오빠야."
msgstr "一隻腳往內折著。防水布、推車輪子……是哥。"

#. Key:	FinalRevealKnockCaption
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1652)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1652)
msgctxt "IGMissingFloor,FinalRevealKnockCaption"
msgid "멀리서 두 번 두드리는 소리"
msgstr "遠處傳來兩下敲擊聲"

#. Key:	MokHansooFinalLine
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1697)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1697)
msgctxt "IGMissingFloor,MokHansooFinalLine"
msgid "그만해요. 덮어야 돼. 이거… 말해 봤자 아무도 안 믿어요."
msgstr "夠了。得封起來。這種事……說出去也沒人會信。"

#. Key:	MokHansooName
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1703)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1703)
msgctxt "IGMissingFloor,MokHansooName"
msgid "목한수"
msgstr "睦漢洙"

#. Key:	YudamName
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1718)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1718)
msgctxt "IGMissingFloor,YudamName"
msgid "백유담"
msgstr "白侑潭"

#. Key:	FinaleDragCaption
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1869)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1869)
msgctxt "IGMissingFloor,FinaleDragCaption"
msgid "석고 가루 위로 무겁게 끌리는 소리"
msgstr "在石膏粉上沉重拖行的聲音"

#. Key:	FinalConfrontationAfter
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1966)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(1966)
msgctxt "IGMissingFloor,FinalConfrontationAfter"
msgid "나를 지나쳐서 관리인을 따라갔어."
msgstr "從我身邊經過，跟著管理員走了。"

#. Key:	MokRetreatStepsCaption
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2026)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2026)
msgctxt "IGMissingFloor,MokRetreatStepsCaption"
msgid "뒷걸음치는 발소리"
msgstr "往後退的腳步聲"

#. Key:	EvictionPostedCaption
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2111)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2111)
msgctxt "IGMissingFloor,EvictionPostedCaption"
msgid "4층 복도에서 종이 붙이는 소리"
msgstr "四樓走廊傳來貼紙張的聲音"

#. Key:	CleaningDrainThought
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2205)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2205)
msgctxt "IGMissingFloor,CleaningDrainThought"
msgid "아래쪽 배관으로 물이 빠진다."
msgstr "水從下面的管子排掉了。"

#. Key:	FloatBypassThought
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2207)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2207)
msgctxt "IGMissingFloor,FloatBypassThought"
msgid "급수관에서도 물소리가 난다."
msgstr "給水管也有水聲了。"

#. Key:	TransferPumpThought
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2208)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2208)
msgctxt "IGMissingFloor,TransferPumpThought"
msgid "펌프가 돌기 시작했다."
msgstr "馬達開始轉了。"

#. Key:	P5OverflowAlarm
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2270)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2270)
msgctxt "IGMissingFloor,P5OverflowAlarm"
msgid "물이 넘친다. 배수 밸브를 안 열었어."
msgstr "水滿出來了。排水閥沒打開。"

#. Key:	P5PressureAlarm
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2274)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2274)
msgctxt "IGMissingFloor,P5PressureAlarm"
msgid "펌프가 멈췄다. 고장등 꺼질 때까지 기다리자."
msgstr "馬達停了。等故障燈熄了再說。"

#. Key:	P5MaskReady
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2479)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2479)
msgctxt "IGMissingFloor,P5MaskReady"
msgid "물 도는 동안엔 벽 치는 소리가 묻히겠다."
msgstr "水還在流的時候，敲牆的聲音應該會被蓋過去。"

#. Key:	NightFourRecordingArmed
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2491)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2491)
msgctxt "IGMissingFloor,NightFourRecordingArmed"
msgid "폰 녹음 켜 두자. 이번엔 뭐라도 남겨야 해."
msgstr "先開手機錄音。這次一定要留下點什麼。"

#. Key:	NightFourRecordingLifted
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2535)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2535)
msgctxt "IGMissingFloor,NightFourRecordingLifted"
msgid "폰을 보니 방금 그 소리가 다 찍혀 있다."
msgstr "看了手機，剛才的聲音全都錄下來了。"

#. Key:	P2PhoneKept
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2542)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2542)
msgctxt "IGMissingFloor,P2PhoneKept"
msgid "녹음됐다. 이번엔 제대로 됐어."
msgstr "錄到了。這次有錄好。"

#. Key:	NightFourStrikeFirst
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2672)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2672)
msgctxt "IGMissingFloor,NightFourStrikeFirst"
msgid "석고에 금이 갔다."
msgstr "石膏裂開了。"

#. Key:	NightFourStrikeSecond
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2674)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2674)
msgctxt "IGMissingFloor,NightFourStrikeSecond"
msgid "안이 비었어. 소리가 달라."
msgstr "裡面是空的。聲音不一樣。"

#. Key:	NightFourStrikeFourth
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2675)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2675)
msgctxt "IGMissingFloor,NightFourStrikeFourth"
msgid "손이 저리다. 한 번만 더."
msgstr "手好麻。再一下。"

#. Key:	Unit401ReplyCaption
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2707)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2707)
msgctxt "IGMissingFloor,Unit401ReplyCaption"
msgid "둘, 쉬고, 하나"
msgstr "兩下，停一下，再一下"

#. Key:	NightFourPowerCut
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2790)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2790)
msgctxt "IGMissingFloor,NightFourPowerCut"
msgid "불이 나갔어. 밑에 누가 있어."
msgstr "燈熄了。下面有人。"

#. Key:	BreakerCutCaption
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2796)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2796)
msgctxt "IGMissingFloor,BreakerCutCaption"
msgid "차단기 내리는 소리"
msgstr "扳下斷路器的聲音"

#. Key:	ConfrontationReplyFoam
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2938)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2938)
msgctxt "IGMissingFloor,ConfrontationReplyFoam"
msgid "관리실 안쪽 방이요. 문틈까지 계란판 붙여 놓으셨더라고요."
msgstr "管理室裡面那間房。你連門縫都貼了雞蛋盒。"

#. Key:	ConfrontationReplyCalendar
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2945)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2945)
msgctxt "IGMissingFloor,ConfrontationReplyCalendar"
msgid "달력이요. 26일에 동그라미 치고, 그 뒤로 한 장도 안 넘기셨죠."
msgstr "那本月曆。你在26日畫了圈，之後一頁都沒翻過吧。"

#. Key:	ConfrontationReplyGlove
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2952)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2952)
msgctxt "IGMissingFloor,ConfrontationReplyGlove"
msgid "5층 장갑에 석고가 굳어 있던데요. 아저씨 거예요?"
msgstr "五樓有一隻手套。我哥戴的話大了兩號。"

#. Key:	ConfrontationReplyRecorder
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2959)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2959)
msgctxt "IGMissingFloor,ConfrontationReplyRecorder"
msgid "녹화기 하드는 언제 빼셨어요?"
msgstr "錄影主機的硬碟，你是什麼時候拔掉的？"

#. Key:	ConfrontationReplyInnerRoom
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2966)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2966)
msgctxt "IGMissingFloor,ConfrontationReplyInnerRoom"
msgid "안쪽 방에 뭘 계속 돌려 놓으셨던데요. 그래서 못 들으셨어요?"
msgstr "你在裡面那間房一直開著什麼東西在轉。所以才沒聽到嗎？"

#. Key:	ConfrontationReplyWind
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2973)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2973)
msgctxt "IGMissingFloor,ConfrontationReplyWind"
msgid "옥상에서 바람 들어 봤어요. 바람이 둘, 쉬고, 하나로 불어요?"
msgstr "我在頂樓聽過風聲。風會照兩下，停一下，再一下那樣吹嗎？"

#. Key:	ConfrontationReplyPack
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2984)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2984)
msgctxt "IGMissingFloor,ConfrontationReplyPack"
msgid "탱크 옆에 꽁초 여섯 개요. 거기 앉아서 쉬던 사람이 있었다고요."
msgstr "水塔旁邊有六根菸蒂。以前明明有人坐在那裡休息。"

#. Key:	ConfrontationReplyBowl
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2991)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2991)
msgctxt "IGMissingFloor,ConfrontationReplyBowl"
msgid "401호 할머니는 아직도 물그릇을 갈아 놓으세요. 매일요."
msgstr "401的阿嬤到現在都還會換那碗水。每天都換。"

#. Key:	ConfrontationReplyPills
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2998)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(2998)
msgctxt "IGMissingFloor,ConfrontationReplyPills"
msgid "서일영 씨 아세요? 골목에 그분 약봉투가 떨어져 있던데요."
msgstr "巷子裡掉的藥袋上，有徐一英的名字。"

#. Key:	EndingBRecordingOffCaption
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(3153)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(3153)
msgctxt "IGMissingFloor,EndingBRecordingOffCaption"
msgid "폰 녹음 끄는 소리"
msgstr "關掉手機錄音的聲音"

#. Key:	EndingAChoiceThought
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(3161)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(3161)
msgctxt "IGMissingFloor,EndingAChoiceThought"
msgid "여기 내려놓자. 밖에 나가서 사람을 불러야 해."
msgstr "放在這裡吧。得出去找人來。"

#. Key:	EndingBChoiceThought
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(3165)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(3165)
msgctxt "IGMissingFloor,EndingBChoiceThought"
msgid "조금만 더 여기 있을게."
msgstr "我再待一下。"

#. Key:	EndingBAnswerCaption
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(3351)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(3351)
msgctxt "IGMissingFloor,EndingBAnswerCaption"
msgid "복도 끝에서 대답하듯 두 번 두드리는 소리"
msgstr "走廊盡頭傳來像在回應的兩下敲擊聲"

#. Key:	EndingBRingbackCaption
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(3433)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(3433)
msgctxt "IGMissingFloor,EndingBRingbackCaption"
msgid "112 연결음"
msgstr "撥打112的等待音"

#. Key:	EndingCCaption
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(3599)
#: Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(3599)
msgctxt "IGMissingFloor,EndingCCaption"
msgid "아주 가까이서, 똑같이 두 번 두드리는 소리"
msgstr "極近處傳來一模一樣的兩下敲擊聲"

#. Key:	EvictionNoticePrompt
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorNightFourDirector.cpp(420)
