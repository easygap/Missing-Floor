msgid "[간이침대가 삐걱거리는 소리]"
msgstr "［行軍床嘎吱作響］"

#. Key:	LeftoverWakeSwitch
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1314)
#: Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1314)
