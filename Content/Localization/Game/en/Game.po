msgstr "Audio & Brightness"

#. Key:	AudioCalibrationFirstRunSubtitle
#. SourceLocation:	Source/IndieGame/Player/IGHorrorHUD.cpp(7661)
#: Source/IndieGame/Player/IGHorrorHUD.cpp(7661)
msgctxt "IGHUD,AudioCalibrationFirstRunSubtitle"
msgid "시작하기 전에 소리 크기와 화면 밝기를 맞춰 주세요."
msgstr "Before you start, set the volume and screen brightness."

#. Key:	AudioCalibrationSubtitle
#. SourceLocation:	Source/IndieGame/Player/IGHorrorHUD.cpp(7662)
#: Source/IndieGame/Player/IGHorrorHUD.cpp(7662)
msgctxt "IGHUD,AudioCalibrationSubtitle"
msgid "헤드폰이나 모니터를 바꿨다면 다시 맞춰 주세요."
msgstr "If you’ve switched headphones or monitors, set these again."

#. Key:	AudioCalibrationKnockLabel
#. SourceLocation:	Source/IndieGame/Player/IGHorrorHUD.cpp(7695)
#: Source/IndieGame/Player/IGHorrorHUD.cpp(7695)
msgctxt "IGHUD,AudioCalibrationKnockLabel"
msgid "위층에서 두드리는 소리"
msgstr "Upstairs Knocking"

#. Key:	AudioCalibrationKnockInstruction
#. SourceLocation:	Source/IndieGame/Player/IGHorrorHUD.cpp(7704)
#: Source/IndieGame/Player/IGHorrorHUD.cpp(7704)
