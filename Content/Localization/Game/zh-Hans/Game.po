msgid "관리실 안쪽 방은 방음 시공돼 있었다"
msgstr "管理室里屋做过隔音处理"

#. Key:	EpilogueNews3
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorEpilogueDirector.cpp(943)
#: Source/IndieGame/Entity/IGMissingFloorEpilogueDirector.cpp(943)
msgctxt "IGMissingFloor,EpilogueNews3"
