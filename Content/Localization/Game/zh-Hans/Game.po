msgid "[간이침대가 삐걱거리는 소리]"
msgstr "［行军床吱呀作响］"

#. Key:	LeftoverWakeSwitch
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1378)
#: Source/IndieGame/Entity/IGMissingFloorLeftoverDirector.cpp(1378)
